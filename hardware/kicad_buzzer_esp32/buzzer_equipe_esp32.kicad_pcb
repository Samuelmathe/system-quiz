	(gr_text "BUZZER EQUIPE -- ESP32 (ESP-NOW, secours) -- placement + reperes seulement\nROUTAGE DES PISTES A FAIRE A LA MAIN DANS KICAD"
		(at 8 9 0)
		(layer "F.SilkS")
		(uuid "2374bc45-be64-4eab-aabb-81ebcbba0775")
		(effects
			(font
				(size 1.1 1.1)
				(thickness 0.15)
			)
			(justify left)
		)
	)
	(gr_text "-- BROCHAGE --\nU1 vers ESP32: 1 GPIO4(bouton) 2 GPIO13(vibreur IN) 3 5V/VIN 4 GND\nGPIO2 (LED embarquee) interne au module, rien a router ici\nSW1 bouton BUZZ: 1 vers GPIO4  2 vers GND\nJ2 module charge: 1 BAT+ 2 BAT- 3 5V+(boost) 4 5V-(boost)\nBT1 batterie: 1 BAT+  2 BAT-\nSW2 interrupteur: 1 depuis boost 5V  2 vers alim carte\nJ3 vibreur: 1 IN(vers GPIO13) 2 VCC(5V) 3 GND\nRappel: meme canal ESPNOW_WIFI_CHANNEL que le hub (firmware, pas le PCB)"
		(at 7 98 0)
		(layer "F.SilkS")
		(uuid "be89a95c-3d68-4697-a8a3-08461e16c46d")
		(effects
			(font
				(size 0.9 0.9)
				(thickness 0.15)
			)
			(justify left)
		)
	)
